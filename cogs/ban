async def resolve_user(guild: discord.Guild, bot: commands.Bot, user_input: str):
    if not user_input:
        return None, "", None

    clean_input = user_input.strip()

    # Mention format check <@!123456789> or <@123456789>
    mention_match = re.match(r'^<@!?(\d+)>$', clean_input)
    if mention_match:
        user_id = int(mention_match.group(1))
        member = guild.get_member(user_id) if guild else None
        if member:
            return member, member.name, user_id
        try:
            fetched = await bot.fetch_user(user_id)
            return fetched, fetched.name, user_id
        except Exception:
            return user_id, str(user_id), user_id

    # Raw digit ID
    if clean_input.isdigit():
        user_id = int(clean_input)
        member = guild.get_member(user_id) if guild else None
        if member:
            return member, member.name, user_id
        try:
            fetched = await bot.fetch_user(user_id)
            return fetched, fetched.name, user_id
        except Exception:
            return user_id, clean_input, user_id

    # Match member by username / display name in guild
    if guild:
        search_term = clean_input.lstrip('@').lower()
        for member in guild.members:
            if (member.name.lower() == search_term or
                (member.global_name and member.global_name.lower() == search_term) or
                member.display_name.lower() == search_term or
                str(member).lower() == search_term):
                return member, member.name, member.id

        # Fallback partial match in guild
        for member in guild.members:
            if (search_term in member.name.lower() or
                (search_term in member.global_name.lower() if member.global_name else False) or
                search_term in member.display_name.lower()):
                return member, member.name, member.id

    return None, clean_input.lstrip('@'), None


async def resolve_banned_user(guild: discord.Guild, bot: commands.Bot, user_input: str):
    clean_input = user_input.strip()

    user_id = None
    mention_match = re.match(r'^<@!?(\d+)>$', clean_input)
    if mention_match:
        user_id = int(mention_match.group(1))
    elif clean_input.isdigit():
        user_id = int(clean_input)

    ban_entries = []
    if guild:
        try:
            ban_entries = [entry async for entry in guild.bans()]
        except Exception:
            ban_entries = []

    # Search by ID if available
    if user_id:
        for entry in ban_entries:
            if entry.user.id == user_id:
                return entry.user, entry.user.name, entry.user.id
        try:
            fetched = await bot.fetch_user(user_id)
            return fetched, fetched.name, user_id
        except Exception:
            return user_id, str(user_id), user_id

    # Search by username in ban list
    search_term = clean_input.lstrip('@').lower()
    for entry in ban_entries:
        u = entry.user
        if (u.name.lower() == search_term or
            (u.global_name and u.global_name.lower() == search_term) or
            str(u).lower() == search_term):
            return u, u.name, u.id

    return None, clean_input.lstrip('@'), None


class BanCog(commands.Cog):
    def __init__(self, bot: commands.Bot):
        self.bot = bot

    # Listener to auto-track message activity and profanity
    @commands.Cog.listener()
    async def on_message(self, message: discord.Message):
        if message.author.bot or not message.guild:
            return

        content_lower = message.content.lower()
        has_bad_word = False
        detected_words = []

        bad_words_list = getattr(config, "BAD_WORDS", [])
        for bw in bad_words_list:
            pattern = r'\b' + re.escape(bw) + r'\b'
            if re.search(pattern, content_lower):
                has_bad_word = True
                detected_words.append(bw)

        # Track message activity
        await increment_user_activity(message.author.id, guild_id=message.guild.id if message.guild else None, has_bad_word=has_bad_word)

        # Log bad word infraction if triggered
        if has_bad_word:
            log_filter(message.author, detected_words, message.channel)
            await add_infraction(
                user_id=message.author.id,
                moderator_id=self.bot.user.id,
                action_type="BAD_WORD",
                reason=f"Used bad word(s): {', '.join(detected_words)}",
                guild_id=message.guild.id if message.guild else None
            )

